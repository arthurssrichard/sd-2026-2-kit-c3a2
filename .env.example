# ============================================================
# Configuração da plataforma (copie para .env: `cp .env.example .env`)
# ============================================================

# Segurança
JWT_SEGREDO=troque-este-segredo
JWT_EXPIRA_MINUTOS=120
# Usuários de demonstração (usuario:senha, separados por vírgula). TROQUE aqui.
USUARIOS=aluno:aluno123,maria:maria456
LIMITE_POR_MINUTO=30

# Rede interna (compose)
REDIS_URL=redis://redis:6379/0
URL_INFERENCIA=http://inferencia:8001
QDRANT_URL=http://qdrant:6333

# Modelo / memória vetorial
VETOR_DIM=32

# Fila e resultados
TAREFA_TTL_SEGUNDOS=3600
MAX_REENTREGAS=3
FILA_CHAVE=fila:tarefas

# Autoescalador (extensão)
LIMIAR_FILA_POR_WORKER=10
MAX_WORKERS=4
AUTOESCALADOR_INTERVALO_S=15

# Deploy público: nome DNS da VM, sem protocolo nem barra
DOMINIO=

# Rastreamento no Compose
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
